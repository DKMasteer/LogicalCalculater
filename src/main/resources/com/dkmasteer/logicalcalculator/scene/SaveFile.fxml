<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="249.0" prefWidth="400.0" style="-fx-background-color: #F8F8F8;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dkmasteer.logicalcalculator.controller.SaveFileController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label alignment="CENTER" prefHeight="27.0" prefWidth="191.0" style="-fx-text-fill: #333333; -fx-font-size: 16px; -fx-font-weight: bold;" text="Введите название файла">
                    <font>
                        <Font name="Helvetica Bold" size="10.0" />
                    </font>
                </Label>
                <TextField fx:id="fileName_tf" promptText="Введите название файла" style="-fx-background-color: white; -fx-border-color: #D0D0D0; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px; -fx-font-size: 14px;" />
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button fx:id="save_btn" mnemonicParsing="false" onAction="#save" style="-fx-font-size: 14px; -fx-pref-width: 120px;" styleClass="primary" text="Сохранить" />
                        <Button fx:id="cancel_btn" mnemonicParsing="false" onAction="#cancel" style="-fx-font-size: 14px; -fx-pref-width: 120px; -fx-background-color: #F5F5F5; -fx-text-fill: #333333; -fx-border-color: #D0D0D0;" text="Отмена" />
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
